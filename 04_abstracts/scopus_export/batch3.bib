@BOOK{Imani202481,
	author = {Imani, Negin and Vale, Brenda},
	title = {Biomimetic architecture: exploring adaptive facades inspired by nature},
	year = {2024},
	journal = {Intelligent Buildings and Infrastructure with Sustainable and Social Values: Third edition},
	pages = {81 - 94},
	doi = {10.1108/978-1-83549-818-720243007},
	url = {https://www.scopus.com/pages/publications/105018429412?origin=resultslist},
	affiliations = {Centre for Sustainability, University of Otago, Dunedin, New Zealand; Open Polytechnic, Wellington, New Zealand; Wellington School of Architecture, Victoria University, Wellington, New Zealand},
	abstract = {This chapter discusses the importance of biomimetics in the built environment and presents a brief history of the field. Biomimetics, or biologically inspired design, involves using nature as a model for developing sustainable and innovative solutions to human problems. The paper highlights the potential benefits of biomimetic design, including increased energy efficiency. It also introduces a systematic approach to designing biomimetic buildings, which involves identifying problems, researching relevant biological systems, and translating biological principles to building design principles. The chapter then focuses on one example of biomimetic design: the development of adaptive building facades (ABFs) that mimic the ability of biological systems to regulate temperature, light, and water content. An in-depth investigation of stomata, the small pores on plant leaves that help regulate heat exchange and conserve water, is presented as a biological thermal adaptation mechanism that has inspired the design of ABFs. Finally, the chapter discusses future approaches to Bio-ABF development, including the integration of new materials and technologies and continued research into biological thermal adaptation mechanisms. Overall, the emphasis is on the importance of biomimetic design in creating sustainable and innovative solutions for the built environment. © Emerald Publishing Limited 2024. All rights reserved.},
	keywords = {Biological materials; Biological systems; Biomimetic materials; Biomimetic processes; Energy efficiency; Plants (botany); Structural design; Adaptation mechanism; Biologically inspired design; Biomimetic design; Building facades; Built environment; Energy; Innovative solutions; Potential benefits; Sustainable solution; Thermal adaptation; Architectural design},
