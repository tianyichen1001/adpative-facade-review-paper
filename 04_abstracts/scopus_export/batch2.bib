@ARTICLE{Gao2025,
	author = {Gao, Mingyi and Zhao, Lihua and Gao, Ge and Jin, Rong and Nie, Zichuan},
	title = {A method for achieving optimal thermal performance of adaptive opaque facades based on monthly loads across China},
	year = {2025},
	journal = {Journal of Building Engineering},
	volume = {102},
	pages = {},
	doi = {10.1016/j.jobe.2025.111813},
	url = {https://www.scopus.com/pages/publications/85216645086?origin=resultslist},
	affiliations = {State Key Laboratory of Subtropical Building and Urban Science, School of Architecture, South China University of Technology, Guangzhou, 510640, China; School of Architecture and Civil Engineering, Xihua University, Chengdu, 610039, China},
	abstract = {With the promotion of nearly zero energy buildings (nZEBs) in China, adaptive opaque facades (AOFs) have gained attention for their high energy-saving potential. Recent research on AOFs has focused on dynamic thermal behaviors and simulations of specific elements or systems. Limited studies on their climate specific thermal requirements which is critical for engineers and AOF producers. This paper develops an analytical methodology to evaluate the energy-saving performance of AOFs in office buildings across China. Optimal AOF designs were determined based on monthly energy loads for different orientations in five cities with varying climates. Two parameters were used to quantify AOF performance: solar absorption (SA) and heat-transfer coefficient (K). Results showed that: 1) Energy savings for office buildings with optimized AOFs reached 1.41 %, 2.42 %, 3.40 %, 6.07 %, and 3.08 % in Harbin, Beijing, Nanchang, Kunming, and Guangzhou, respectively. 2) High SA values and thick insulation (low K values) were optimal in all climate zones in winter. In Harbin and Beijing, adaptive insulation with broad range variation was necessary, while in Nanchang, Kunming, and Guangzhou, high flexibility in K values proved most beneficial. 3) Adaptive SA values were not universally advantageous; for instance, in Harbin, south-facing facades saved 0.57 %, while north-facing facades only saved 0.17 %. In Beijing and Nanchang, adaptive SA values most benefitted the south facing facades. However, in Kunming and Guangzhou the west facing facades benefited most due to solar radiation levels. 4) The inappropriate design or control of AOFs may have counterproductive effects on energy-savings and thermal comfort. © 2025},
	author_keywords = {Adaptive opaque facade; Cooling and heating loads; Energy-saving; Heat-transfer coefficient (K value); Solar absorption (SA value)},
	keywords = {Facings; Absorption values; Adaptive opaque facade; Cooling load; Energy  savings; Energy-savings; Heat transfer co-efficients; Heat-transfer coefficient (K value); Heating load; K-values; Solar absorption; Solar absorption (solar absorption value); Energy saving},
	correspondence_address = {Z. Nie; State Key Laboratory of Subtropical Building and Urban Science, School of Architecture, South China University of Technology, Guangzhou, 510640, China; email: 202210181024@mail.scut.edu.cn},
	publisher = {Elsevier Ltd},
