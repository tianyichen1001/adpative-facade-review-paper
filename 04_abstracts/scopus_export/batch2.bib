@ARTICLE{Ali Abaker Omer2025,
	author = {Ali Abaker Omer, Altyeb and Li, Ming and Zhang, Fangxin and Hassaan, Mohmmed Mun Elseed and El Kolaly, Wael and Zhang, Xinyu and Lan, Huayan and Liu, Jie and Liu, Wen},
	title = {Impacts of agrivoltaic systems on microclimate, water use efficiency, and crop yield: A systematic review},
	year = {2025},
	journal = {Renewable and Sustainable Energy Reviews},
	volume = {221},
	pages = {},
	doi = {10.1016/j.rser.2025.115930},
	url = {https://www.scopus.com/pages/publications/105007295168?origin=resultslist},
	affiliations = {School of Tea and Coffee, Puer University, Puer, 665000, China; School of Physical Sciences, University of Science and Technology of China, Hefei, 230026, China; Institute of Advanced Technology, University of Science and Technology of China, Hefei, 230094, China; Institute of Plasma Physics, Hefei Institute of Physical Science, Chinese Academy of Sciences, Hefei, 230031, China; School of Science and Technology, Puer University, Puer, 665000, China; Agricultural Engineering Research Institute, Agricultural Research Center, 256 Dokki, Giza, Egypt},
	abstract = {Agrivoltaic (AV) systems have emerged as a transformative solution to address the interrelated global challenges of food security, water conservation, and renewable energy generation. This study aims to provide a systematic review of 33 studies published between 2013 and 2023, analyzing the impacts of AV systems on microclimate regulation, evapotranspiration (ET), soil evaporation, water-use efficiency (WUE), and crop yield across diverse agricultural and climatic contexts. The findings highlight that AV systems improve WUE by 20–47 %, lower air and soil temperatures by 1–4 °C, and enhance crop resilience in water-scarce regions. However, yield reductions are observed in light-dependent crops under high shading intensities, underscoring the need for tailored designs that optimize shading intensity while balancing energy generation and agricultural productivity. Advanced technologies, such as dynamic shading systems and semi-transparent photovoltaic (PV) panels, are identified as critical for maximizing AV efficiency and adaptability to specific regional needs. This study also addresses significant gaps in the literature, including the underrepresentation of tropical and arid climates, insufficient long-term ecological assessments, and the lack of comprehensive economic feasibility analyses for large-scale implementation. By integrating geographic and temporal trends, diverse methodological approaches, and innovative PV technologies, this study provides actionable research directions for optimizing AV system scalability and sustainability, advancing AV systems as a cornerstone of climate-resilient and sustainable agriculture. © 2025 Elsevier Ltd},
	author_keywords = {Agrivoltaic; Climate resilience; Crop yield; Microclimate; Renewable energy; Sustainability; Water use efficiency},
	keywords = {Agricultural robots; Hydroelectric power; Reforestation; Seed; Solar fuels; Sustainable agriculture; Wave power; Agrivoltaic; Climate resilience; Crop yield; Food security; Global challenges; Microclimate; Renewable energies; Shading intensity; Systematic Review; Water use efficiency; Crops},
