@ARTICLE{Huang2025,
	author = {Huang, Yujian and Zeng, Tiancheng and Jia, Meilin and Yang, Jiarui and Xu, Weiguo and Lu, Shuai},
	title = {Fusing Transformer and diffusion for high-resolution prediction of daylight illuminance and glare based on sparse ceiling-mounted input},
	year = {2025},
	journal = {Building and Environment},
	volume = {267},
	pages = {},
	doi = {10.1016/j.buildenv.2024.112163},
