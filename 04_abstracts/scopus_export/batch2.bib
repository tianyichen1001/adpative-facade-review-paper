@ARTICLE{Li2025,
	author = {Li, Chunying and Xie, Jixing and Liu, Ruixue and Tan, Junyi and Zhu, Xiaojiao and Li, Na and Tang, Haida},
	title = {Fully exploiting solar energy with building envelops: Experimental study on an adjustable photovoltaic green facade},
	year = {2025},
	journal = {Energy and Buildings},
	volume = {332},
	pages = {},
