@ARTICLE{Lor2025,
	author = {Lor, Sotheaudom and Dong, Yajie and Luo, Tao and Bian, Yu and Xu, Nan and Zhang, Nan and Xue, Peng},
	title = {A field-based evaluation of blackboard visibility in daylit classrooms},
	year = {2025},
	journal = {Journal of Building Engineering},
	volume = {114},
	pages = {},
	doi = {10.1016/j.jobe.2025.114475},
	url = {https://www.scopus.com/pages/publications/105019742966?origin=resultslist},
	affiliations = {Beijing Key Laboratory of Green Built Environment and Energy Efficient Technology, Beijing University of Technology, Beijing, 100124, China; Real Estate Development Co., Ltd., China Railway 22nd Bureau Group, Beijing, 100041, China; Chongqing Research Institute of Beijing University of Technology, Chongqing, 401121, China; China Academy of Building Research, Beijing, China; School of Architecture//State Key Laboratory of Subtropical Building Science, South China University of Technology, Guangzhou, China; Institute of Architecture Design and Research, Chinese Academy of Sciences, Beijing, 100086, China},
	abstract = {Daylight plays a critical role in shaping the visual quality of indoor educational spaces, influencing blackboard visibility and instructional effectiveness. Most existing studies have examined visual factors such as viewing angle, chalk color, and shading in isolation, without addressing how these elements interact under dynamic daylight conditions. A field-based study was conducted to evaluate the influence of curtain-mediated daylight modulation on blackboard visibility, considering its interaction with chalk color, viewing angle, and blackboard area. A full-factorial field experiment was carried out in a naturally lit classroom across four curtain openness ratios (0/3, 1/3, 2/3, 3/3), six chalk colors (white, yellow, orange, green, red, blue), eight viewing angles (20°–90°), and five blackboard regions (A–E). Objective visibility was assessed using chalk–background luminance contrast, and subjective assessments were obtained via a five-point visibility scale. Results indicated that visibility was greatest under fully open curtain conditions, particularly from frontal viewing angles and with high-reflectance chalks such as yellow and green. Visibility was highest in board zones closest to the windows and declined with distance, reflecting uneven daylight distribution. A significant monotonic relationship between luminance contrast and visibility ratings (r<sub>s</sub> = 0.69, p < 0.001) confirmed luminance contrast as a key determinant of instructional visibility. These findings support daylight-responsive classroom design strategies, including the use of brighter chalks, alignment of instructional zones with daylight gradients, and adaptive shading control to enhance blackboard visibility and ensure equitable viewing conditions for students. © 2025 Elsevier Ltd},
