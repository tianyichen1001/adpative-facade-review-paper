@ARTICLE{Qi2025,
	author = {Qi, Zongxin and Wan, Ziwei and Li, Lingrui and Ma, Qingsong and Gao, Weijun and Wei, Xindong},
	title = {Kirigami-inspired novel photovoltaic shading facade: multi-objective optimization of energy consumption, daylighting, thermal comfort, visual comfort, and landscape view},
	year = {2025},
	journal = {Solar Energy},
	volume = {299},
	pages = {},
	doi = {10.1016/j.solener.2025.113692},
	url = {https://www.scopus.com/pages/publications/105008155170?origin=resultslist},
	affiliations = {iSMART, Qingdao University of Technology, Qingdao, 266033, China; Department of Architecture, The University of Kitakyushu, Kitakyushu, 808-0135, Japan; School of Environmental and Municipal Engineering, Jilin Jianzhu University, Changchun, 130118, China},
	abstract = {With rising global building energy consumption, photovoltaic shading facades (PVSFs) have gained attention for their dual function of solar radiation control and electricity generation. However, most of existing PVSFs are simple louver structures, lacking in-depth exploration of complex aesthetic design and PV self-shading issues, and have repeated evaluation of the schemes. Inspired by kirigami, this paper designed a novel lightweight honeycomb PVSF, aiming to improve the indoor environment and energy consumption while improving the efficiency of photovoltaic power generation (PVPG). The study also comprehensively considers comfort and view, and combines criteria importance through intercriteria correlation (CRITIC) and analytic hierarchy process (AHP) to assign weights, aiming to improve the accuracy of decision making. Results showed that the optimal solution improved net EUI, UDIe, UDI<sub>100-3000</sub>, and TCP by 20.1%, 70.8%, 5.4%, and 23%, respectively, compared to the baseline. The view reached 19.75%, within the user-acceptable range; the PV self-shading rate was only 4.7%, significantly lower than traditional PV blinds. Compared with single-objective optimization, the multi-objective optimization (MOO) scheme demonstrated superior overall performance. Sensitivity analysis showed that the number of vertical grids had the greatest impact, and bond length had the smallest impact, but it did not have a negative impact on other objectives. Climate adaptability analysis showed that honeycomb PVSF effectively optimized energy consumption and indoor environment, but had limitations in cold regions such as Changchun. The research results have demonstrated the advantages of the novel PVSF and optimized MOO process, and provide a reference for PVSF design and MOO. © 2025 International Solar Energy Society},
	author_keywords = {Kirigami structure; Multi-objective optimization; Parametric performance design; Photovoltaic self-shading; Photovoltaic shading facade},
	keywords = {Changchun; China; Jilin; Analytic hierarchy process; Bond length; Decision making; Energy efficiency; Energy utilization; Photovoltaics; Sensitivity analysis; Solar energy; Solar power generation; Structural design; Structural optimization; Kirigami structure; Multi-objectives optimization; Parametric performance; Parametric performance design; Performances design; Photovoltaic self-shading; Photovoltaic shading facade; Photovoltaics; Self-shading; correlation; design method; electricity generation; energy use; exploration; optimization; photovoltaic system; shading; solar radiation; Multiobjective optimization},
	correspondence_address = {Q. Ma; iSMART, Qingdao University of Technology, Qingdao, 266033, China; email: maqingsong@qut.edu.cn},
	publisher = {Elsevier Ltd},
	issn = {0038092X},
	coden = {SRENA},
	language = {English},
	abbrev_source_title = {Sol. Energy},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 6}
}

@CONFERENCE{Chen2025305,
	author = {Chen, Zijie and Tang, Chao and Herr, Christiane M.},
	title = {A Workflow for Implementing Reinforcement Learning Incorporating Occupant Preference in Climate-Adaptive Facade Control},
	year = {2025},
	journal = {Proceedings of the International Conference on Computer-Aided Architectural Design Research in Asia},
	volume = {3},
	pages = {305 - 314},
	doi = {10.52842/conf.caadria.2025.3.305},
	url = {https://www.scopus.com/pages/publications/105023482070?origin=resultslist},
	affiliations = {Southern University of Science and Technology, China; University College London, United Kingdom},
	abstract = {Indoor air quality (IAQ) and thermal comfort significantly influence occupants, who spend most of their time indoors. Climate-adaptive façades (CAFs) can modify their configurations in response to external conditions, and contribute significantly to improving and maintaining a desirable IAQ and thermal comfort. In response to contemporary CAF systems, which tend to generalize comfort levels, this paper addresses the difficulties of accommodating individual comfort preferences. To this end, we propose a novel workflow for training reinforcement learning (RL) controllers tailored for high-performance CAFs that incorporate fine-tuning mechanisms. RL has been widely adopted as a control strategy for various building components and equipment, such as HVAC systems. However, the application of RL to CAFs remains underexplored. Existing RL controllers for the built environment are typically trained on generalized comfort models, which can lead to incompatibilities between human self-determined operation of environment control systems based on variable personal comfort perceptions and digitally predetermined optimum values. This misalignment can result in occupant discomfort and increase energy consumption. In this paper, we conducted an analysis of a naturally ventilated building, and present the results demonstrating the effectiveness of the proposed workflow in aligning an RL-based control system for CAFs with individual occupant comfort preferences. © 2025 and published by the Association for Computer-Aided Architectural Design Research in Asia (CAADRIA), Hong Kong.},
	author_keywords = {Climate-adaptive facades; Naturally ventilated buildings; Occupant-centric control; Personal occupant comfort; Reinforcement learning},
	keywords = {Adaptive control systems; Architectural design; Energy utilization; Facades; HVAC; Indoor air pollution; Man machine systems; Room and pillar mining; Thermal comfort; Climate-adaptive facade; Indoor air quality; Learning controllers; Naturally ventilated buildings; Occupant comforts; Occupant-centric control; Personal occupant comfort; Reinforcement learnings; Thermal; Work-flows; Reinforcement learning},
	editor = {Reinhardt D. and Globa A. and Rogeau N. and Herr C.M. and Chen J. and Narahara T.},
	publisher = {The Association for Computer-Aided Architectural Design Research in Asia},
	issn = {27104257},
	isbn = {978-988789186-4},
	language = {English},
	abbrev_source_title = {Proc. Int. Conf. Comput.-Aided Architect. Des. Res. Asia},
	type = {Conference paper},
