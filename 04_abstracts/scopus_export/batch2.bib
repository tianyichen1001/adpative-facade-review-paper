@CONFERENCE{Zhang2025213,
	author = {Zhang, Hank and Wang, Yuxiao and Xu, Le and Cong, Huating and Li, Chen and Lu, Junjie and Chen, Jianhao},
	title = {A Data-Driven Optimization Control Framework for Adaptive Solar Façades Balancing Photovoltaic Performance and Indoor Environment},
	year = {2025},
	journal = {Proceedings of the International Conference on Computer-Aided Architectural Design Research in Asia},
	volume = {3},
