@ARTICLE{Noor2025,
	author = {Noor, Mahya Cheshmeh and Saradj, Fatemeh Mehdizadeh and Yazdanfar, Seyed-Abbas},
	title = {Optimal daylighting design for standard photopic and melanopic equivalent daylight illuminance, and glare minimization in Tehran classrooms},
	year = {2025},
	journal = {Journal of Building Engineering},
	volume = {105},
	pages = {},
	doi = {10.1016/j.jobe.2025.112104},
	url = {https://www.scopus.com/pages/publications/105000918728?origin=resultslist},
	affiliations = {School of Architecture and Environmental Design, Iran University of Science and Technology, Tehran, Iran},
	abstract = {Taking advantage of adequate daylight in schools is crucial not only for visual tasks but also for its non-visual effects, including the melanopic effects of light that promote alertness and regulate the sleep-wake cycle. This study seeks to determine the optimal factors for daylighting design by analyzing various window-to-wall ratios (WWRs) and wall surface reflection coefficients in three prevailing classroom geometries. The goal is to achieve sufficient photopic illuminance (for visual activities) and melanopic equivalent daylight illuminance (M-EDI) (for promoting alertness) while minimizing glare. A simulation method utilizing ALFA and Climate Studio software was conducted at two climatically critical times for elementary school classrooms in Tehran. The findings offer a range of acceptable values to enhance its applicability in the current classroom. The optimal solutions for achieving both M-EDI and photopic illuminance while minimizing glare are: an east-west rectangle geometry with a WWR of 40 % and a reflection coefficient of 75 %, a square geometry with a WWR of 30 % and a reflection coefficient of 75 %, and a north-south rectangle geometry with a WWR of 40 % and a reflection coefficient of 80 %. The results can be implemented into current classroom design guidelines to enhance healthier and more efficient daylighting in educational settings, which typically prioritize visual activities and require revision due to their inadequacy. Further evaluations of annual daylighting scenarios and dynamic shading are recommended for future studies. © 2025 Elsevier Ltd},
	author_keywords = {Classroom; Daylighting; Melanopic equivalent daylight illuminance; Plan geometry; Wall reflectance; Window},
